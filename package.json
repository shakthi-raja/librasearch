{
  "name": "librasearch",
  "version": "0.0.0",
  "private": true,
  "description": "Syllabus-aware discovery and demand-adaptive circulation for a campus library",
  "type": "module",
  "packageManager": "pnpm@12.2.0",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && tsc --noEmit",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "lefthook": "2.1.12",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
