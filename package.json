{
  "name": "librasearch",
  "version": "0.0.0",
  "private": true,
  "description": "Syllabus-aware discovery and demand-adaptive circulation for a campus library",
  "type": "module",
  "packageManager": "pnpm@12.2.0",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "biome check . && next typegen && tsc --noEmit",
    "prepare": "lefthook install",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:watch": "vitest --project unit",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:status": "tsx scripts/migrate.ts status",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.0",
    "ioredis": "6.0.0",
    "mysql2": "3.24.2",
    "next": "16.3.4",
    "pino": "10.3.1",
    "rate-limiter-flexible": "11.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "lefthook": "2.1.12",
    "pino-pretty": "13.1.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
