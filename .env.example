# Copy to .env and replace every change-me value. .env is git-ignored.
# docker compose and the app both read this file.

# containers
MYSQL_ROOT_PASSWORD=change-me
MYSQL_HOST_PORT=3307
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
REDIS_PASSWORD=change-me
REDIS_HOST_PORT=6380
DB_NAME=librasearch

# app
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# mysql: the admin credential is for migrations, seed and tests only
DB_HOST=127.0.0.1
DB_PORT=3307
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=change-me
DB_AUTH_USER=app_auth
DB_AUTH_PASSWORD=change-me
DB_STUDENT_USER=app_student
DB_STUDENT_PASSWORD=change-me
DB_FACULTY_USER=app_faculty
DB_FACULTY_PASSWORD=change-me
DB_LIBRARIAN_USER=app_librarian
DB_LIBRARIAN_PASSWORD=change-me
DB_POOL_SIZE=10

# qdrant and redis
QDRANT_URL=http://127.0.0.1:6333
# empty for the app; the test suite uses test_
QDRANT_COLLECTION_PREFIX=
REDIS_URL=redis://:change-me@127.0.0.1:6380/0

# embeddings
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_DTYPE=q8

# sessions
SESSION_COOKIE_NAME=ls_session
SESSION_IDLE_HOURS=168
SESSION_ABSOLUTE_HOURS=720

# digital library card: signs the QR members show at the desk and kiosk
# (at least 32 characters, for example: openssl rand -base64 32)
CARD_SECRET=change-me

# google sign-in: optional, leave empty to hide the button. The OAuth client
# needs APP_URL/api/v1/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# worker
WORKER_POLL_MS=2000
WORKER_BATCH_SIZE=25
